{
  "name": "badminton-youtube-uploader",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build && node scripts/remove-local-build-secrets.mjs",
    "check": "tsc -b --pretty false && prettier --check .",
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "password:hash": "node scripts/hash-password.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.5",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "unicode-case-folding": "^1.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.27.0",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.131.1"
  },
  "packageManager": "pnpm@12.4.1"
}
