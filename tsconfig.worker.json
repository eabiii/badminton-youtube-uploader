{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types", "vitest/globals", "node"]
  },
  "include": ["worker", "shared", "test/**/*.ts", "vitest.config.ts", "drizzle.config.ts", "playwright.config.ts"]
}
